// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PartnerType {
  SUPPLIER
  CUSTOMER
}

enum MovementType {
  IN
  OUT
}

enum CustomerSegment {
  HOUSEHOLD // บ้าน
  GROCERY // ร้านชำ
  SHOP // ร้านค้า
  RESTAURANT // ร้านอาหาร
  OFFICE // ออฟฟิศ
  FACTORY // โรงงาน
  OTHER
}

enum ChannelType {
  OFFLINE
  ONLINE
}

// สถานะออเดอร์ที่ลูกค้ายืนยันแล้ว ก่อนกลายเป็นใบขายออก
enum OrderStatus {
  CONFIRMED // ลูกค้ายืนยัน รอส่ง
  DELIVERED // คนขับส่งแล้ว สร้างใบขายออกแล้ว
  FAILED // คนขับส่งไม่ได้ รอ admin เลื่อนวันหรือยกเลิก
  CANCELLED
}

// เหตุการณ์ที่ลูกค้าเป็นต้นเหตุให้ส่งไม่สำเร็จ ใช้ประกอบการขึ้นบัญชีดำ
enum IncidentKind {
  CANCELLED // ลูกค้ายกเลิกออเดอร์
  NO_ANSWER // ไม่รับสาย / ติดต่อไม่ได้ / ไม่อยู่ตอนส่ง
}

enum DeliveryMethod {
  DELIVERY // ร้านไปส่งเอง
  PICKUP // ลูกค้ามารับที่คลัง
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id               String         @id @default(cuid())
  name             String
  unit             String // เช่น ถัง 20L, แพ็ค 12 ขวด
  size             String? // เช่น 1.5L, 600ml, 350ml ใช้จัดกลุ่มข้ามยี่ห้อ
  brand            Brand?         @relation(fields: [brandId], references: [id])
  brandId          String?
  orderLines       OrderLine[]
  transferLines    TransferLine[]
  defaultCostPrice Float? // ราคาต้นทุนต่อแพ็คที่ใช้ตั้งต้นในฟอร์มรับเข้า
  defaultSellPrice Float? // ราคาขายต่อแพ็คที่ใช้ตั้งต้นในฟอร์มขายออก
  reorderPoint     Int            @default(0) // แจ้งเตือนเมื่อสต็อกต่ำกว่านี้
  movementLines    MovementLine[]
  stockCounts      StockCount[]
  createdAt        DateTime       @default(now())
}

model Partner {
  id              String             @id @default(cuid())
  name            String
  type            PartnerType
  companyName     String? // ชื่อบริษัท ไม่บังคับ
  isBlacklisted   Boolean            @default(false) // บัญชีดำ: ลูกค้ายกเลิกหรือติดต่อไม่ได้บ่อย
  blacklistReason String?
  blacklistedAt   DateTime?
  incidents       CustomerIncident[]
  facebookName    String? // ชื่อ Facebook ของลูกค้า ใช้ดูคู่กับชื่อจริงเพราะบางคนไม่ตรงกัน ไม่บังคับ
  phone           String?
  address         String?
  mapUrl          String? // ลิงก์ Google Maps ที่ลูกค้าส่งมา
  latitude        Float? // พิกัดที่ดึงจากลิงก์ ใช้วิเคราะห์โซนและนำทาง
  longitude       Float?
  segment         CustomerSegment? // ประเภทลูกค้า ใช้กับ CUSTOMER เท่านั้น
  zone            String? // โซน/ตำบล แยกจากที่อยู่เพื่อใช้จัดกลุ่มในรายงาน
  source          CustomerSource?    @relation(fields: [sourceId], references: [id])
  sourceId        String? // รู้จักร้านจากช่องทางไหน ว่าง = ไม่ทราบ
  movements       Movement[]
  orders          Order[]
  createdAt       DateTime           @default(now())
}

// ช่องทางที่ได้ลูกค้า เช่น บอกต่อ, ใบปลิว เพิ่มเองได้จากหน้าจอเผื่อช่องทางออนไลน์ในอนาคต
model CustomerSource {
  id        String      @id @default(cuid())
  name      String      @unique
  channel   ChannelType
  isActive  Boolean     @default(true) // ปิดเพื่อซ่อนจากตัวเลือก โดยไม่กระทบลูกค้าเดิม
  partners  Partner[]
  createdAt DateTime    @default(now())
}

model Warehouse {
  id           String       @id @default(cuid())
  name         String // เช่น บ้านแม่, บ้านย่า
  latitude     Float? // พิกัดคลัง ใช้เรียงงานคนขับจากใกล้ไปไกล
  longitude    Float?
  isActive     Boolean      @default(true) // ปิดแล้วไม่แสดงในตัวเลือกใหม่ แต่ประวัติและสต็อกเดิมยังอยู่
  movements    Movement[]
  stockCounts  StockCount[]
  orders       Order[]
  transfersOut Transfer[]   @relation("TransferFrom")
  transfersIn  Transfer[]   @relation("TransferTo")
  createdAt    DateTime     @default(now())
}

// ใบรับเข้า/ขายออก 1 ใบ มีได้หลายสินค้า (multi-line) เหมือนใบสั่งซื้อ
model Movement {
  id             String          @id @default(cuid())
  type           MovementType
  partner        Partner         @relation(fields: [partnerId], references: [id])
  partnerId      String
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  warehouseId    String
  note           String?
  deliveryMethod DeliveryMethod? // ใช้กับใบขายออก ว่าง = ใบเก่าที่ไม่ได้บันทึกไว้
  date           DateTime        @default(now())
  lines          MovementLine[]
  order          Order? // ออเดอร์ที่สร้างใบนี้ตอนคนขับกดส่งแล้ว
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ออเดอร์ที่ลูกค้ายืนยันแล้ว ยังไม่ตัดสต็อกจนกว่าคนขับจะส่งสำเร็จ
model Order {
  id              String             @id @default(cuid())
  partner         Partner            @relation(fields: [partnerId], references: [id])
  partnerId       String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  warehouseId     String // คลังที่โหลดของขึ้นรถ
  orderDate       DateTime           @default(now()) // วันที่ลูกค้าสั่ง แก้ย้อนหลังได้ (ต่างจาก createdAt)
  deliveryDate    DateTime
  deliveryRound   String // คีย์รอบจัดส่ง เช่น "08-10" ดูรายการใน lib/delivery.ts
  deliveryAddress String? // ที่อยู่เฉพาะออเดอร์นี้ ว่าง = ใช้ที่อยู่ลูกค้า
  note            String? // หมายเหตุถึงคนขับ
  status          OrderStatus        @default(CONFIRMED)
  issueReason     String? // เหตุผลที่ส่งไม่ครบหรือส่งไม่ได้ เช่น แพ็คน้ำแตก
  deliveredAt     DateTime?
  paidAt          DateTime? // admin ยืนยันว่าลูกค้าโอนแล้ว
  movement        Movement?          @relation(fields: [movementId], references: [id], onDelete: SetNull)
  movementId      String?            @unique
  lines           OrderLine[]
  incidents       CustomerIncident[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model OrderLine {
  id                String  @id @default(cuid())
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  product           Product @relation(fields: [productId], references: [id])
  productId         String
  quantity          Int // จำนวนที่ลูกค้าสั่ง คนขับแก้ไม่ได้
  deliveredQuantity Int? // จำนวนที่ส่งจริง บันทึกตอนส่ง
  unitPrice         Float
}

// รายการสินค้าย่อยในใบรับเข้า/ขายออก
model MovementLine {
  id         String   @id @default(cuid())
  movement   Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  movementId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  unitPrice  Float
}

// โอนย้ายสินค้าระหว่างคลัง ไม่กระทบยอดรับเข้า/ขายออก/กำไร มีผลแค่สต็อกรายคลัง
model Transfer {
  id              String         @id @default(cuid())
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  fromWarehouseId String
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  toWarehouseId   String
  date            DateTime       @default(now())
  note            String?
  lines           TransferLine[]
  createdAt       DateTime       @default(now())
}

model TransferLine {
  id         String   @id @default(cuid())
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
}

// ประวัติเหตุการณ์ของลูกค้า (ยกเลิก/ติดต่อไม่ได้) บันทึกอัตโนมัติจากคนขับและตอนยกเลิกออเดอร์ หรือบันทึกเอง
model CustomerIncident {
  id        String       @id @default(cuid())
  partner   Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  kind      IncidentKind
  note      String?
  createdAt DateTime     @default(now())

  @@index([partnerId, createdAt])
}

// ค่าใช้จ่ายดำเนินงาน เช่น ค่าเช่า ค่าน้ำมัน ค่าแรง ใช้หักจากกำไรขั้นต้นเพื่อหากำไรสุทธิ
model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
}

// บันทึกผลนับสต็อกจริงตามรอบ (เช่น รอบ 13 มิ.ย.) แยกตามคลังและขนาดน้ำ
model StockCount {
  id          String           @id @default(cuid())
  date        DateTime
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  warehouseId String
  product     Product          @relation(fields: [productId], references: [id])
  productId   String
  note        String?
  lines       StockCountLine[]
  createdAt   DateTime         @default(now())
}

// รายการย่อยของการนับ เช่น "พาเลซใหญ่" 162, "กระดาษใหญ่" 36 ตามลักษณะการจัดเก็บจริง
model StockCountLine {
  id           String     @id @default(cuid())
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  stockCountId String
  label        String
  quantity     Int
}
